<Window x:Class="CSharp_Calculator_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharp_Calculator_GUI"
        mc:Ignorable="d"
        Title="Calculatrice" Height="450" Width="350" MinHeight="400" MinWidth="300"> 

    <Window.Resources>
        <!-- le Style sera défini ici -->
        <Style x:Key="BoutonBase" TargetType="Button" >
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonNumero" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BorderBrush" Value="#A1A1A1"/>
            <Setter Property="Background" Value="#E3E3E3"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E3E3E3"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BorderBrush" Value="#787878"/>
            <Setter Property="Background" Value="#BDBDBD"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3E3E3"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
            
        </Style>

        <Style x:Key="BoutonEgal" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
            <Setter Property="BorderBrush" Value="#5E3B25"/>
            <Setter Property="Background" Value="#E68A4E"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A36237"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E68A4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="#AED69C" Margin="2 2 2 10" BorderBrush="#424A3D" BorderThickness="2" CornerRadius="8">
            <StackPanel VerticalAlignment = "Center" >
                <TextBlock x:Name="StockedText" Text="test" VerticalAlignment = "Center" TextAlignment="Right"  FontSize="20" Margin="20 5 20 0"/>
                <TextBlock x:Name="DisplayText" Text="0" VerticalAlignment = "Center" TextAlignment="Right"  FontSize="32" Margin="15 3 15 5"/>
            </StackPanel>
        </Border>

        <Button Content="%" Grid.Row="1" Grid.Column="0" Style="{StaticResource BoutonAction}"/>
        <Button Content="CE" Grid.Row="1" Grid.Column="1" Style="{StaticResource BoutonAction}"/>
        <Button Content="C" Grid.Row="1" Grid.Column="2" Style="{StaticResource BoutonAction}"/>
        <Button Content="DEL" Grid.Row="1" Grid.Column="3" Style="{StaticResource BoutonAction}"/>
        <Button Content="1/𝑥" Grid.Row="2" Grid.Column="0" Style="{StaticResource BoutonAction}"/>
        <Button Content="𝑥²" Grid.Row="2" Grid.Column="1" Style="{StaticResource BoutonAction}"/>
        <Button Content="√𝑥" Grid.Row="2" Grid.Column="2" Style="{StaticResource BoutonAction}"/>
        <Button Content="÷" Grid.Row="2" Grid.Column="3" Click="GetOperator" Style="{StaticResource BoutonAction}"/>
        <Button Content="7" Grid.Row="3" Grid.Column="0" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="8" Grid.Row="3" Grid.Column="1" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="9" Grid.Row="3" Grid.Column="2" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="×" Grid.Row="3" Grid.Column="3" Click="GetOperator" Style="{StaticResource BoutonAction}"/>
        <Button Content="4" Grid.Row="4" Grid.Column="0" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="5" Grid.Row="4" Grid.Column="1" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="6" Grid.Row="4" Grid.Column="2" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="-" Grid.Row="4" Grid.Column="3" Click="GetOperator" Style="{StaticResource BoutonAction}"/>
        <Button Content="1" Grid.Row="5" Grid.Column="0" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="2" Grid.Row="5" Grid.Column="1" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="3" Grid.Row="5" Grid.Column="2" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="+" Grid.Row="5" Grid.Column="3" Click="GetOperator" Style="{StaticResource BoutonAction}"/>
        <Button Content="+/-" Grid.Row="6" Grid.Column="0" Style="{StaticResource BoutonAction}"/>
        <Button Content="0" Grid.Row="6" Grid.Column="1" Click="GetNumber" Style="{StaticResource BoutonNumero}"/>
        <Button Content="," Grid.Row="6" Grid.Column="2" Style="{StaticResource BoutonNumero}"/>
        <Button Content="=" Grid.Row="6" Grid.Column="3" Style="{StaticResource BoutonEgal}"/>

    </Grid>
</Window>
