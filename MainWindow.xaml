<Window x:Class="CSharp_Calculator_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharp_Calculator_GUI"
        mc:Ignorable="d"
        Title="Calculatrice" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="#B5E890" Margin="2 2 2 10" BorderBrush="#26361A" BorderThickness="2" CornerRadius="8">
            <TextBlock Text="Texte Test" VerticalAlignment = "Center" TextAlignment="Right"  FontSize="36" Margin="20 10"/>
        </Border>

        <Button Content="%" Grid.Row="1" Grid.Column="0" FontSize="24" Margin="2"/>
        <Button Content="CE" Grid.Row="1" Grid.Column="1" FontSize="24" Margin="2"/>
        <Button Content="C" Grid.Row="1" Grid.Column="2" FontSize="24" Margin="2"/>
        <Button Content="DEL" Grid.Row="1" Grid.Column="3" FontSize="24" Margin="2"/>
        <Button Content="1/𝑥" Grid.Row="2" Grid.Column="0" FontSize="24" Margin="2"/>
        <Button Content="𝑥²" Grid.Row="2" Grid.Column="1" FontSize="24" Margin="2"/>
        <Button Content="√𝑥" Grid.Row="2" Grid.Column="2" FontSize="24" Margin="2"/>
        <Button Content="÷" Grid.Row="2" Grid.Column="3" FontSize="24" Margin="2"/>
        <Button Content="7" Grid.Row="3" Grid.Column="0" FontSize="24" Margin="2"/>
        <Button Content="8" Grid.Row="3" Grid.Column="1" FontSize="24" Margin="2"/>
        <Button Content="9" Grid.Row="3" Grid.Column="2" FontSize="24" Margin="2"/>
        <Button Content="×" Grid.Row="3" Grid.Column="3" FontSize="24" Margin="2"/>
        <Button Content="4" Grid.Row="4" Grid.Column="0" FontSize="24" Margin="2"/>
        <Button Content="5" Grid.Row="4" Grid.Column="1" FontSize="24" Margin="2"/>
        <Button Content="6" Grid.Row="4" Grid.Column="2" FontSize="24" Margin="2"/>
        <Button Content="-" Grid.Row="4" Grid.Column="3" FontSize="24" Margin="2"/>
        <Button Content="1" Grid.Row="5" Grid.Column="0" FontSize="24" Margin="2"/>
        <Button Content="2" Grid.Row="5" Grid.Column="1" FontSize="24" Margin="2"/>
        <Button Content="3" Grid.Row="5" Grid.Column="2" FontSize="24" Margin="2"/>
        <Button Content="+" Grid.Row="5" Grid.Column="3" FontSize="24" Margin="2"/>
        <Button Content="+/-" Grid.Row="6" Grid.Column="0" FontSize="24" Margin="2"/>
        <Button Content="0" Grid.Row="6" Grid.Column="1" FontSize="24" Margin="2"/>
        <Button Content="," Grid.Row="6" Grid.Column="2" FontSize="24" Margin="2"/>
        <Button Content="=" Grid.Row="6" Grid.Column="3" FontSize="24" Margin="2"/>

    </Grid>
</Window>
